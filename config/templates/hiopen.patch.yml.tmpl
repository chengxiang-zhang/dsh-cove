# HiOpen provider preset for DSH. Credentials stay in
# $DSH_HOME/.credentials.yaml as refs.HIOPEN_API_KEY.
#
# The public /v1/models endpoint advertises many routes, including embeddings,
# detectors, guard models, and currently unavailable NVIDIA NIM functions. This
# curated list contains chat models that are useful to a tool-using DSH agent.
# Model ids are copied exactly from the endpoint. Capacity and modality facts use
# vendor metadata and live endpoint probes; conservative declarations fail early
# instead of stranding a durable conversation on an unsupported image request.
- id: llm-deepseek
  name: "@deepseek-ai/dsh-llm-deepseek-api-key"
  config:
    baseURL: {{llm.hiopen.baseUrl}}

- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      hiopen:
        displayName: HiOpen
        apiKeyEnv: HIOPEN_API_KEY
        api: openai-completions
        baseURL: {{llm.hiopen.baseUrl}}
        streamIdleTimeoutMs: 1800000
        reasoning: high
        defaultContextWindow: 262144
        defaultMaxTokens: 32768
        defaultInput:
          - text
        compat:
          supportsDeveloperRole: false
          supportsReasoningEffort: true
          supportsUsageInStreaming: true
          maxTokensField: max_tokens
        models:
          - id: deepseek-ai/deepseek-v4.1-flash
            name: DeepSeek V4.1 Flash
            contextWindow: 1048576
            maxTokens: 262144
            input:
              - text
              - image
            reasoningEfforts:
              low: "low"
              medium: "medium"
              high: "high"
              max: "max"
            compat:
              thinkingFormat: deepseek
              requiresReasoningContentOnAssistantMessages: true
          - id: deepseek-v4-flash-0731
            name: DeepSeek V4 Flash 0731
            contextWindow: 1000000
            maxTokens: 128000
            input:
              - text
            reasoningEfforts:
              low: "low"
              medium: "medium"
              high: "high"
              max: "max"
            compat:
              thinkingFormat: deepseek
              requiresReasoningContentOnAssistantMessages: true
          - id: z-ai/glm-5.3
            name: GLM 5.3
            contextWindow: 1048576
            maxTokens: 131072
            input:
              - text
            reasoningEfforts:
              low: "low"
              high: "high"
              max: "max"
            compat:
              thinkingFormat: zai
              requiresReasoningContentOnAssistantMessages: true
          - id: z-ai/glm-5.3-flash
            name: GLM 5.3 Flash
            contextWindow: 1048576
            maxTokens: 131072
            input:
              - text
              - image
            reasoningEfforts:
              low: "low"
              high: "high"
              max: "max"
            compat:
              thinkingFormat: zai
              requiresReasoningContentOnAssistantMessages: true
          - id: openai/gpt-oss-20b
            name: GPT OSS 20B
            contextWindow: 131072
            maxTokens: 32768
            input:
              - text
            reasoningEfforts:
              low: "low"
              medium: "medium"
              high: "high"
          - id: meta/llama-3.2-90b-vision-instruct
            name: Llama 3.2 90B Vision Instruct
            contextWindow: 131072
            maxTokens: 8192
            input:
              - text
              - image
            reasoningEfforts: false
