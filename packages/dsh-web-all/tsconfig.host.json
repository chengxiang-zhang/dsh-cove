{
  // Host-half program (node process side): all service domains under src/host
  // plus the host entry. SDK types resolve from the @deepseek-ai/* packages
  // declared in devDependencies (official NPM SDK), never from a source
  // checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/invariant.ts",
    "src/host/**/*.ts",
    "src/core/**/*.ts"
  ]
}