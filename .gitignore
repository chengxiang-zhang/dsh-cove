.npmrc

# 本地工具缓存
*.log
.DS_Store
.codegraph/

# GUI 测试截图
gui-test-screenshots/

# 本地性能调试脚本
.dsh/perf/

# 本地调试探针脚本（不入库）
.dsh/*.js
.dsh/*.py

# worktree 插件运行时状态（含本地绝对路径，不入库）
.dsh/workspaces/

# 评审提示草稿：本地资料，不上传
REVIEW-PROMPT.md
# 营销视频工程：本地生成，不上传
/marketing/dsh-web-ui-promo-60s/

