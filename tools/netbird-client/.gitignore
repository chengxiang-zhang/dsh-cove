# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Testing and temporary scratch
/coverage
**/.tmp/

# Archived native reference workspace (contains nested repositories and toolchains)
# The archive/ symlink points to a per-machine path (/data/archives/...) and is
# not portable; the archived reference stays on dl-dev only.
/archive

# Local project memory and journey state
/PROJECT_MEMORY.md
/.sdd/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# NetBird portal build workspace (AAR rebuild cache)
.nb-build/

# Release artifacts (APKs, simulator builds) — keep builds out of git
/dist/
*.apk
*.zip

# The iOS engine binding is built, not committed: Portal.xcframework is ~235 MB across
# device and simulator slices, and scripts/build-xcframework.sh produces it from
# native/*.go in minutes. ios-release.yml builds it before pod install.
ios/Portal.xcframework/

# The workspace is regenerated by `pod install`, which ios-release.yml runs before
# building; the committed Podfile.lock is what keeps that reproducible.
ios/*.xcworkspace/
