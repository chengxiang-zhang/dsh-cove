{
  "name": "dsh-api-proxy",
  "version": "1.0.0",
  "description": "OpenAI-compatible API proxy turning Claude, Codex and Cursor logins into API endpoints",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "tsx src/index.ts --login",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx --test tests/smoke.test.ts",
    "prettier": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.21.0",
    "js-yaml": "^4.3.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "license": "Apache-2.0"
}
