# Environment for the NetBird dashboard container (`/opt/netbird/dashboard.env`).
#
# The one value a deployment must set here is the client secret of the dashboard
# client in NetBird's embedded IdP: that IdP's token endpoint (`/oauth2/token`)
# rejects an authorization-code exchange without it, which is what the console
# sign-in path depends on. Generate it with the deployment, keep it out of the
# repository, and restart the dashboard container after changing it.
AUTH_CLIENT_SECRET=__DASHBOARD_CLIENT_SECRET__