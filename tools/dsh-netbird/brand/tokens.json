  "consoleLadder": {
    "$comment": [
      "The management console is a compiled Next.js export whose Tailwind palette is",
      "named after the vendor and compiled to literal rgb() values (there is no CSS",
      "variable to redefine), so its accent utilities can only be overridden by class",
      "name. This ladder has the same lightness steps as the orange ramp it replaces,",
      "so every vendor utility maps to a step of the same visual weight rather than",
      "collapsing to a single brand colour. `aw-brand.css` lists one override per",
      "selector that actually exists in the shipped stylesheet."
    ],
    "50": "#EFF5FF",
    "100": "#DCE8FE",
    "150": "#C7DBFE",
    "200": "#B3CEFD",
    "300": "#8FB6FC",
    "400": "#60A5FA",
    "500": "#3B82F6",
    "600": "#2563EB",
    "700": "#1D4ED8",
    "900": "#132B6B",
    "950": "#0C1B45"
  },

