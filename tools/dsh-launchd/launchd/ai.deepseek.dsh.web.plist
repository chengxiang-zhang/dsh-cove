<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.deepseek.dsh.web</string>
	<key>UserName</key>
	<string>__USER__</string>
	<key>GroupName</key>
	<string>staff</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DSH_HOME</key>
		<string>__HOME__/.dsh</string>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__HOME__/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.dsh/bin/start-dsh-web.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.dsh/logs/web.launchd.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.dsh/logs/web.launchd.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>__REPO_DIR__</string>
</dict>
</plist>
